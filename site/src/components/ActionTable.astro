---
import GradeBadge from './GradeBadge.astro';
import { t, type Locale } from '../i18n';
import type { ActionRow } from '../lib/actions';
import { getDepartment, getDistrict } from '../lib/data';
import { tips } from '../lib/tips';

interface Props {
  rows: ActionRow[];
  locale?: Locale;
}

const { rows, locale = 'en' } = Astro.props;
const { TIP } = tips(locale);
const sitePath = (id: string) => (locale === 'ml' ? `/ml/sites/${id}/` : `/sites/${id}/`);
---

{rows.length === 0 && <p class="d-muted">{t(locale, 'actions.empty')}</p>}
{
  rows.length > 0 && (
    <div class="d-card d-card--flush" style="overflow-x:auto" data-tip={TIP.actionTable} tabindex="0">
    <table class="d-table" data-sortable>
      <thead>
        <tr>
          <th scope="col">{t(locale, 'actions.col.site')}</th>
          <th scope="col">{t(locale, 'actions.col.department')}</th>
          <th scope="col">{t(locale, 'actions.col.district')}</th>
          <th scope="col">{t(locale, 'actions.col.grade')}</th>
          <th scope="col">{t(locale, 'actions.col.problem')}</th>
          <th scope="col">{t(locale, 'actions.col.count')}</th>
          <th scope="col">{t(locale, 'actions.col.checked')}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr data-grade={typeof row.bucket === 'number' ? row.bucket : undefined} data-bucket={row.bucket}>
            <td><a href={sitePath(row.site.id)}>{row.site.name}</a></td>
            <td>{getDepartment(row.site.department)?.name ?? row.site.department}</td>
            <td>{row.site.district ? (getDistrict(row.site.district)?.name ?? row.site.district) : ''}</td>
            <td data-sort={typeof row.bucket === 'number' ? row.bucket : 9}><GradeBadge bucket={row.bucket} locale={locale} compact /></td>
            <td>
              {row.top ? (
                <>
                  <strong>{row.top.title}</strong>
                  <br />
                  {row.top.citizen}
                </>
              ) : null}
            </td>
            <td data-sort={row.actions.length}>{row.actions.length}</td>
            <td data-sort={row.checked ?? ''}>{row.checked ? row.checked.slice(0, 10) : ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  )
}

<script>
  import '../scripts/sortable-table';
</script>

<style>
  :global(th button) { all: unset; cursor: pointer; text-decoration: underline dotted; font: inherit; color: inherit; }
  :global(th button:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }
  :global(th[aria-sort='ascending'] button::after) { content: ' ▲'; }
  :global(th[aria-sort='descending'] button::after) { content: ' ▼'; }
  td { vertical-align: top; }
  td:nth-child(5) { min-width: 18rem; }
  tr[data-grade='1'] td:first-child { box-shadow: inset 4px 0 0 #7a0019; }
  tr[data-grade='2'] td:first-child { box-shadow: inset 4px 0 0 var(--crimson); }
  tr[data-grade='3'] td:first-child { box-shadow: inset 4px 0 0 #b45309; }
  tr[data-grade='4'] td:first-child { box-shadow: inset 4px 0 0 var(--amber); }
  tr[data-grade='5'] td:first-child { box-shadow: inset 4px 0 0 var(--grey-soft); }
</style>
