---
import type { ScoreBreakdown } from '../../../audit/dist/score.js';
import { t, type Locale } from '../i18n';

interface Props {
  score: ScoreBreakdown | null;
  locale?: Locale;
}

const { score, locale = 'en' } = Astro.props;

const CATEGORIES: { key: Exclude<keyof ScoreBreakdown, 'overall'>; labelKey: Parameters<typeof t>[1] }[] = [
  { key: 'security', labelKey: 'category.security' },
  { key: 'accessibility', labelKey: 'category.accessibility' },
  { key: 'content', labelKey: 'category.content' },
  { key: 'gigw', labelKey: 'category.gigw' },
  { key: 'performance', labelKey: 'category.performance' },
  { key: 'identity', labelKey: 'category.identity' },
];
---

{score ? (
  <ul class="category-bars">
    {CATEGORIES.map(({ key, labelKey }) => {
      const label = t(locale, labelKey);
      return (
        <li>
          <span class="category-bars__label">{label}</span>
          <div class="coverage-bar" role="img" aria-label={`${label}: ${score[key]} ${t(locale, 'score.outOf100')}`}>
            <span style={`width: ${score[key]}%`}></span>
          </div>
          <span class="category-bars__value">{score[key]}</span>
        </li>
      );
    })}
  </ul>
) : (
  // Null here means either DESIGN §5.4's availability gate (a ★ check failed and skipped
  // scoring entirely) or that no deep audit has completed successfully yet -- the page's own
  // status reason / audit-error note above already says which, so this stays generic rather
  // than guessing.
  <p>{t(locale, 'score.notScored')}</p>
)}

<style>
  .category-bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .category-bars li {
    display: grid;
    grid-template-columns: 9rem 1fr 2.5rem;
    align-items: center;
    gap: 0.6rem;
  }
  .category-bars__label {
    font-size: 0.9rem;
  }
  .category-bars__value {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>
