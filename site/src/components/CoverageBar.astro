---
interface Props {
  done: number;
  total: number;
  label: string;
}

const { done, total, label } = Astro.props;
const pct = total === 0 ? 0 : Math.round((done / total) * 100);
---

<div class="coverage">
  <p>{label}</p>
  <div class="coverage-bar" role="img" aria-label={`${pct}% complete`}>
    <span style={`width: ${pct}%`}></span>
  </div>
</div>
