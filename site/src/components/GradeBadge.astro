---
import { t, type Locale } from '../i18n';
import type { Bucket } from '../lib/actions';

interface Props {
  bucket: Bucket;
  locale?: Locale;
  /** Just "Grade N" (for table cells); the full plain-language label is on the grade's own page and tiles. */
  compact?: boolean;
}

const { bucket, locale = 'en', compact = false } = Astro.props;

// Never colour alone (DESIGN §7.4): the digit and the words always show.
const label = typeof bucket === 'number' && compact ? `${t(locale, 'actions.col.grade')} ${bucket}` : typeof bucket === 'number' ? t(locale, `actions.grade.${bucket}.label`) : t(locale, `actions.bucket.${bucket}`);
const tone = typeof bucket === 'number' ? `g${bucket}` : 'none';
---

<span class={`grade-badge grade-badge--${tone}`} title={typeof bucket === 'number' ? t(locale, `actions.grade.${bucket}.label`) : undefined}>
  {typeof bucket === 'number' && <span class="grade-badge__n" aria-hidden="true">{bucket}</span>}
  <span>{label}</span>
</span>

<style>
  .grade-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
    padding: 0.1em 0.65em 0.1em 0.2em;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--color-text);
  }
  .grade-badge__n {
    display: inline-grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    font-weight: 700;
    color: var(--on-fill);
  }
  /* Grade 1 (signs of tampering) to 5 (nothing to do): palette fills, so the badge follows the theme. */
  .grade-badge--g1 .grade-badge__n { background: var(--crimson); color: var(--on-crimson); }
  .grade-badge--g2 .grade-badge__n { background: var(--coral); }
  .grade-badge--g3 .grade-badge__n { background: var(--amber); }
  .grade-badge--g4 .grade-badge__n { background: var(--sky); }
  .grade-badge--g5 .grade-badge__n { background: var(--grey); }
  .grade-badge--g1 { border-color: var(--crimson); }
  .grade-badge--g2 { border-color: var(--coral); }
  .grade-badge--g3 { border-color: var(--amber); }
  .grade-badge--g4 { border-color: var(--sky); }
  .grade-badge--g5 { border-color: var(--grey); }
  .grade-badge--none { padding-left: 0.65em; color: var(--color-muted); }
</style>
