---
import type { Status } from '../lib/data';
import { STATUS_COLOR, STATUS_PILL_FG, STATUS_WORD } from '../lib/bands';
import { STATUS_TIP } from '../lib/tips';
import type { Locale } from '../i18n';

interface Props { status: Status; locale?: Locale }
const { status, locale = 'en' } = Astro.props;

// Malayalam words kept from the original component.
const ML: Record<Status, string> = {
  down: 'പ്രവർത്തനരഹിതം', hijacked: 'ഹൈജാക്ക് ചെയ്തിരിക്കാം — സന്ദർശിക്കരുത്', broken: 'തകരാറിലാണ്',
  unverifiable: 'സ്ഥിരീകരിക്കാൻ കഴിയില്ല', unaudited: 'ഇതുവരെ ഓഡിറ്റ് ചെയ്തിട്ടില്ല', healthy: 'ആരോഗ്യകരം',
  'needs-work': 'പണി ആവശ്യമാണ്', poor: 'മോശം',
};
const word = locale === 'ml' ? ML[status] : STATUS_WORD[status];
// Status is never colour-alone (DESIGN §7.4): the pill always carries the word.
---

<span class="d-pill" style={`--pill:${STATUS_COLOR[status]};${STATUS_PILL_FG[status] ? `--pill-fg:${STATUS_PILL_FG[status]}` : ''}`} data-tip={STATUS_TIP[status]} tabindex="0">
  {word}
</span>
