---
import type { Status } from '../lib/data';
import { STATUS_COLOR, STATUS_PILL_FG, statusWord } from '../lib/bands';
import { tips } from '../lib/tips';
import type { Locale } from '../i18n';

interface Props { status: Status; locale?: Locale }
const { status, locale = 'en' } = Astro.props;

const word = statusWord(status, locale);
const { STATUS_TIP } = tips(locale);
// Status is never colour-alone (DESIGN §7.4): the pill always carries the word.
---

<span class="d-pill" style={`--pill:${STATUS_COLOR[status]};${STATUS_PILL_FG[status] ? `--pill-fg:${STATUS_PILL_FG[status]}` : ''}`} data-tip={STATUS_TIP[status]} tabindex="0">
  {word}
</span>
