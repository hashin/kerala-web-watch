---
import { CHECKS } from '../../../audit/dist/checks/registry.js';
import type { Issue } from '../../../audit/dist/score.js';
import { t, type Locale } from '../i18n';
import { CATEGORY_COLOR } from '../lib/bands';
import { CATEGORY_TIP } from '../lib/tips';

interface Props {
  issue: Issue;
  locale?: Locale;
}

const { issue, locale = 'en' } = Astro.props;
const meta = CHECKS[issue.id];

const SEVERITY_KEY = {
  C: 'severity.C',
  H: 'severity.H',
  M: 'severity.M',
  L: 'severity.L',
  I: 'severity.I',
} as const satisfies Record<Issue['sev'], Parameters<typeof t>[1]>;
---

<article id={`issue-${issue.id}`} class="issue-card">
  <h4 class="issue-card__title">
    <span class="d-dot" style={`--dot:${CATEGORY_COLOR[meta.category]}`} data-tip={CATEGORY_TIP[meta.category]} tabindex="0" role="img" aria-label={`Category: ${meta.category}`}></span>
    <span class="issue-card__sev">{t(locale, SEVERITY_KEY[issue.sev])}</span> {meta.title[locale]}
  </h4>
  <p class="issue-card__citizen">{meta.citizen[locale]}</p>
  {issue.ev && <p class="issue-card__evidence"><code>{issue.ev}</code></p>}
  <details>
    <summary>{t(locale, 'issue.howToFix')}{meta.ref && t(locale, 'issue.andReference')}</summary>
    <p>{meta.fix[locale]}</p>
    {meta.ref && <p class="issue-card__ref">{t(locale, 'issue.reference')}: {meta.ref}</p>}
  </details>
</article>

<style>
  .issue-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 0.75rem 1rem;
    margin-bottom: 0.75rem;
  }
  .issue-card__title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 600;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .issue-card__title .d-dot { flex: none; align-self: center; }
  .issue-card__sev {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .issue-card__citizen {
    margin: 0 0 0.35rem;
  }
  .issue-card__evidence {
    margin: 0 0 0.35rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .issue-card__ref {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
