---
import districtLayout from '../data/kerala-districts.json';
import { getDistricts, getSummary } from '../lib/data';
import type { GroupStat } from '../lib/data';
import { medianColor } from '../lib/bands';

const districts = new Map(getDistricts().map((d) => [d.id, d]));
const byDistrict = getSummary().by_district;

// Real district boundaries need fetching DataMeet's shapefiles (an external download, which
// per this project's rules needs the human's explicit go-ahead first, same as WP0.4's font
// fetch) -- until that happens, WP2.4's own text allows this stand-in: a north-to-south ordered
// strip of bars, never claiming to be an accurate shape. `_source` in the JSON explains why.
const rows = (districtLayout.order as string[]).map((id) => {
  const district = districts.get(id);
  const stat: GroupStat | undefined = byDistrict[id];
  const pct = stat && stat.sites > 0 ? Math.round((stat.broken / stat.sites) * 100) : 0;
  return { id, name: district?.name ?? id, sites: stat?.sites ?? 0, broken: stat?.broken ?? 0, pct, median: stat?.median == null ? null : Math.round(stat.median) };
});

---

<div class="kerala-map">
  <p class="kerala-map__note">Shade shows each district's median score: teal 65 or more, amber 55 to 65, coral under 55, grey not yet scored. Schematic, not to scale — districts ordered north to south.</p>
  <ul class="kerala-map__list">
    {rows.map((row) => {
      return (
        <li>
          <a class="kerala-map__row" href={`/districts/${row.id}/`} style={`background: ${medianColor(row.median)}`}>
            <span class="kerala-map__name">{row.name}</span>
            <span class="kerala-map__pct">{row.median !== null ? `median ${row.median} · ` : ''}{row.pct}% broken ({row.broken}/{row.sites})</span>
          </a>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .kerala-map {
    max-width: 26rem;
  }
  .kerala-map__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .kerala-map__note {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
  }
  .kerala-map__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0.75rem;
    text-decoration: none;
    color: var(--on-fill);
    border-radius: var(--radius);
    flex-wrap: wrap;
  }
  .kerala-map__row:hover,
  .kerala-map__row:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -2px;
  }
  .kerala-map__name { font-weight: 600; }
  .kerala-map__pct { font-variant-numeric: tabular-nums; }
</style>
