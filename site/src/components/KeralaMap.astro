---
import districtLayout from '../data/kerala-districts.json';
import { getDistricts, getSummary } from '../lib/data';
import type { GroupStat } from '../lib/data';

const districts = new Map(getDistricts().map((d) => [d.id, d]));
const byDistrict = getSummary().by_district;

// Real district boundaries need fetching DataMeet's shapefiles (an external download, which
// per this project's rules needs the human's explicit go-ahead first, same as WP0.4's font
// fetch) -- until that happens, WP2.4's own text allows this stand-in: a north-to-south ordered
// strip of bars, never claiming to be an accurate shape. `_source` in the JSON explains why.
const rows = (districtLayout.order as string[]).map((id) => {
  const district = districts.get(id);
  const stat: GroupStat | undefined = byDistrict[id];
  const pct = stat && stat.sites > 0 ? Math.round((stat.broken / stat.sites) * 100) : 0;
  return { id, name: district?.name ?? id, sites: stat?.sites ?? 0, broken: stat?.broken ?? 0, pct };
});

// Accessible 5-step sequential ramp (light -> dark, distinguishable without colour vision) --
// the percentage number is always rendered too, so colour is never the only signal (DESIGN §7.4).
// Each bucket carries its own foreground colour, not a single fixed one: a background ramp that
// spans near-white to saturated red can't share one text colour and keep WCAG AA contrast at both
// ends (found via axe-core during WP4.5's self-audit -- the fixed dark text this used to have
// passed on the light buckets but failed against the darkest one in both colour schemes).
function bucket(pct: number): { bg: string; fg: string } {
  if (pct === 0) return { bg: 'var(--map-0)', fg: 'var(--map-0-fg)' };
  if (pct < 5) return { bg: 'var(--map-1)', fg: 'var(--map-1-fg)' };
  if (pct < 15) return { bg: 'var(--map-2)', fg: 'var(--map-2-fg)' };
  if (pct < 30) return { bg: 'var(--map-3)', fg: 'var(--map-3-fg)' };
  return { bg: 'var(--map-4)', fg: 'var(--map-4-fg)' };
}
---

<div class="kerala-map">
  <p class="kerala-map__note">Percentage of broken government websites by district. Schematic, not to scale — districts ordered north to south.</p>
  <ul class="kerala-map__list">
    {rows.map((row) => {
      const { bg, fg } = bucket(row.pct);
      return (
        <li>
          <a class="kerala-map__row" href={`/districts/${row.id}/`} style={`background: ${bg}; color: ${fg}`}>
            <span class="kerala-map__name">{row.name}</span>
            <span class="kerala-map__pct">{row.pct}% broken ({row.broken}/{row.sites})</span>
          </a>
        </li>
      );
    })}
  </ul>
</div>

<style>
  :root {
    --map-0: #e6f4ea; --map-0-fg: #14181f;
    --map-1: #b7e0c3; --map-1-fg: #14181f;
    --map-2: #f4d35e; --map-2-fg: #14181f;
    --map-3: #ef8354; --map-3-fg: #14181f;
    /* The reddest bucket is dark enough in both colour schemes that white text is the one that
       always passes -- verified against both hex values below, not assumed. */
    --map-4: #c4281c; --map-4-fg: #ffffff;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --map-0: #1e3324; --map-0-fg: #e8ecf1;
      --map-1: #2c4a35; --map-1-fg: #e8ecf1;
      --map-2: #5c4a1f; --map-2-fg: #e8ecf1;
      --map-3: #7a3f26; --map-3-fg: #e8ecf1;
      --map-4: #5c1712; --map-4-fg: #ffffff;
    }
  }
  .kerala-map {
    max-width: 26rem;
  }
  .kerala-map__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .kerala-map__note {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
  }
  .kerala-map__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0.75rem;
    text-decoration: none;
    border-radius: 0.25rem;
  }
  .kerala-map__row:hover,
  .kerala-map__row:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }
  .kerala-map__name { font-weight: 600; }
  .kerala-map__pct { font-variant-numeric: tabular-nums; }
</style>
