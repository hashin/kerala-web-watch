---
// One monthly report: archive list beside the report. Serves /reports/ (the latest month) and /reports/<month>/.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import KpiTile from './KpiTile.astro';
import { reportKpis } from '../lib/reports';
import { tips } from '../lib/tips';
import type { Locale } from '../i18n';

interface Props { entry: CollectionEntry<'reports'>; locale?: Locale }
const { entry, locale = 'en' } = Astro.props;
const { TIP } = tips(locale);
const { Content } = await render(entry);
const archive = (await getCollection('reports')).sort((a, b) => b.data.month.localeCompare(a.data.month));
const kpis = reportKpis(entry.data.snapshot, entry.data.deltas);
---

<Layout title={entry.data.title} description={`Kerala Web Watch's monthly report for ${entry.data.month}: totals, month-over-month changes, top issues, and the best- and worst-scoring sites.`} active="reports">
  <div class="d-prose-wrap">
    <nav class="d-toc" aria-label="Report archive" data-tip={TIP.reportArchive}>
      <b>Reports</b>
      {archive.map((r) => <a href={`/reports/${r.data.month}/`} aria-current={r.data.month === entry.data.month ? 'page' : undefined}>{r.data.month}</a>)}
    </nav>
    <div class="d-stack" style="min-width:0">
      <div>
        <h1 class="d-h1">{entry.data.title}</h1>
        <p class="d-muted" style="margin:.3rem 0 0">Generated {entry.data.generated.slice(0, 10)} · a fixed snapshot; the live numbers are on the <a href="/">home page</a>.</p>
      </div>
      <div class="d-grid d-grid--kpi">
        {kpis.map((k) => <KpiTile label={k.label} value={k.value} color={k.color} tip={k.tip} delta={k.delta} against="vs last month" />)}
      </div>
      {!entry.data.deltas && <p class="d-small d-muted" style="margin:0">This is the first report, so there is no earlier month to compare with yet.</p>}
      <article class="d-prose" data-tip={TIP.reportBody} tabindex="0"><Content /></article>
    </div>
  </div>
</Layout>
