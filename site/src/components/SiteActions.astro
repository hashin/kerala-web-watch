---
import { t, type Locale } from '../i18n';

interface Props {
  id: string;
  name: string;
  locale?: Locale;
}

const { id, name, locale = 'en' } = Astro.props;
const REPO = 'https://github.com/hashin/kerala-web-watch';
// template=correction.yml/reaudit-request.yml (WP4.6) don't exist as issue forms yet -- GitHub
// falls back to a plain pre-titled issue when the template is missing, so these links work today
// and pick up the real form once WP4.6 lands, same "acceptable for one WP" precedent as the
// /api/sites/<id>.json link below (WP4.3).
const correctionUrl = `${REPO}/issues/new?template=correction.yml&title=${encodeURIComponent(`[${id}] Correction: ${name}`)}`;
const reauditUrl = `${REPO}/issues/new?template=reaudit-request.yml&title=${encodeURIComponent(`[${id}] Re-audit request: ${name}`)}`;
const jsonUrl = `/api/sites/${id}.json`;
const shareLabel = t(locale, 'siteActions.share');
const linkCopiedLabel = t(locale, 'siteActions.linkCopied');
---

<ul class="site-actions">
  <li><a href={correctionUrl}>{t(locale, 'siteActions.correction')}</a></li>
  <li><a href={reauditUrl}>{t(locale, 'siteActions.reaudit')}</a></li>
  <li><a href={jsonUrl}>{t(locale, 'siteActions.downloadJson')}</a></li>
  <li><button type="button" class="site-actions__share" data-share-title={name} data-link-copied-label={linkCopiedLabel}>{shareLabel}</button></li>
</ul>

<script>
  // Progressive enhancement only, same-origin, no network request beyond the page already
  // loaded -- doesn't conflict with "no third-party requests" (CLAUDE.md), which is about
  // analytics/CDNs, not same-page JS.
  document.querySelectorAll('.site-actions__share').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = window.location.href;
      const title = btn.getAttribute('data-share-title') || document.title;
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch {
          // User dismissed the native share sheet -- not an error worth surfacing.
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.textContent = btn.getAttribute('data-link-copied-label') || 'Link copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 2000);
      } catch {
        // Clipboard API unavailable (e.g. insecure context) -- nothing more we can do offline.
      }
    });
  });
</script>

<style>
  .site-actions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .site-actions__share {
    font: inherit;
    color: var(--color-link);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }
</style>
