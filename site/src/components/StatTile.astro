---
interface Props {
  label: string;
  value: number;
  tone?: 'good' | 'warn' | 'bad' | 'neutral';
  href?: string;
}

const { label, value, tone = 'neutral', href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class={`stat-tile stat-tile--${tone}`} href={href}>
  <span class="stat-tile__value">{value.toLocaleString('en-IN')}</span>
  <span class="stat-tile__label">{label}</span>
</Tag>

<style>
  .stat-tile {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
  }
  a.stat-tile:hover,
  a.stat-tile:focus-visible {
    border-color: currentColor;
  }
  .stat-tile__value {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .stat-tile__label {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .stat-tile--bad .stat-tile__value { color: var(--color-bad); }
  .stat-tile--warn .stat-tile__value { color: var(--color-warn); }
  .stat-tile--good .stat-tile__value { color: var(--color-good); }
</style>
