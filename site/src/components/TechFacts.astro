---
import { isGovDomain } from '../../../audit/dist/checks/identity.js';
import type { StoredLight, DeepTech } from '../../../audit/dist/store.js';
import { t, type Locale } from '../i18n';

interface Props {
  light: StoredLight | null;
  tech: DeepTech | null;
  platform: string | null;
  locale?: Locale;
}

const { light, tech, platform, locale = 'en' } = Astro.props;
const domain = light?.final_domain ?? null;

const certificateText = light?.tls
  ? `${light.tls.valid ? t(locale, 'tech.valid') : t(locale, 'tech.invalid')}${
      light.tls.days_left !== null
        ? t(locale, 'tech.expiresIn').replace('{n}', String(light.tls.days_left)).replace('{date}', light.tls.expires)
        : ''
    }`
  : '—';
const domainText = domain ? `${domain} — ${isGovDomain(domain) ? t(locale, 'tech.govDomain') : t(locale, 'tech.notGovDomain')}` : '—';
---

<dl class="tech-facts">
  <dt>{t(locale, 'tech.finalUrl')}</dt>
  <dd>{light?.final_url ?? '—'}</dd>

  <dt>{t(locale, 'tech.server')}</dt>
  <dd>{tech?.server ?? '—'}</dd>

  <dt>{t(locale, 'tech.cms')}</dt>
  <dd>{tech?.cms ?? t(locale, 'tech.notDetected')}</dd>

  <dt>{t(locale, 'tech.certificate')}</dt>
  <dd>{certificateText}</dd>

  <dt>{t(locale, 'tech.domain')}</dt>
  <dd>{domainText}</dd>

  <dt>{t(locale, 'tech.platform')}</dt>
  <dd>{platform ?? t(locale, 'tech.noPlatform')}</dd>
</dl>

<style>
  .tech-facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1rem;
  }
  .tech-facts dt {
    color: var(--color-muted);
  }
  .tech-facts dd {
    margin: 0;
  }
</style>
