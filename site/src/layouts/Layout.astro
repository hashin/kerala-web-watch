---
import '../styles/global.css';
import '../styles/dashboard.css';
import PagefindSearch from '../components/PagefindSearch.astro';
import { t, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  locale?: Locale;
  altLangHref?: string;
  altLangLabel?: string;
  /** Which primary-nav tab is active: snapshot | districts | ministries | leaderboard | reports | methodology | about */
  active?: string;
}

const { title, description, lang = 'en', locale = 'en', altLangHref, altLangLabel, active } = Astro.props;
const homeHref = locale === 'ml' ? '/ml/' : '/';
const aboutHref = locale === 'ml' ? '/ml/about/' : '/about/';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const lastUpdated = new Date().toISOString().slice(0, 10);
const NAV = [
  ['snapshot', 'Snapshot', homeHref],
  ['districts', 'Districts', '/districts/'],
  ['ministries', 'Ministries', '/ministries/'],
  ['actions', t(locale, 'nav.actions'), locale === 'ml' ? '/ml/actions/' : '/actions/'],
  ['leaderboard', 'Leaderboard', '/leaderboard/'],
  ['reports', 'Reports', '/reports/'],
  ['methodology', 'Methodology', '/methodology/'],
  ['about', t(locale, 'nav.about'), aboutHref],
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Kerala Web Watch</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="d-head">
      <div class="d-head__in">
        <a class="d-brand" href={homeHref}><i aria-hidden="true"></i>Kerala Web Watch</a>
        <nav class="d-nav" aria-label="Primary">
          {NAV.map(([key, label, href]) => (
            <a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <PagefindSearch id="header-search" lazy />
        {altLangHref && <a href={altLangHref} hreflang={altLangLabel === 'English' ? 'en' : 'ml'}>{altLangLabel}</a>}
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <p>
        Kerala Web Watch is an independent, open-data civic audit. No cookies, no analytics, no
        third-party requests. Content owned and maintained by Hashin Jithu; designed, developed
        and hosted by Hashin Jithu. Last updated {lastUpdated}.
      </p>
      <nav aria-label="Policies and help" class="site-footer__policies">
        <a href="/about/#contact">Contact Us</a>
        <a href="https://github.com/hashin/kerala-web-watch/issues">Feedback</a>
        <a href="/sitemap-index.xml">Sitemap</a>
        <a href="/about/#privacy">Privacy Policy</a>
        <a href="/about/#terms">Terms and Conditions</a>
        <a href="/about/#copyright-policy">Copyright Policy</a>
        <a href="/about/#hyperlinking-policy">Hyperlinking Policy</a>
        <a href="/about/#disclaimer">Disclaimer</a>
        <a href="/about/#accessibility">Accessibility Statement</a>
        <a href="/about/#screen-reader">Screen Reader Access</a>
        <a href="/methodology/">Help</a>
        <a href="/about/#rti">Right to Information (RTI)</a>
      </nav>
    </footer>

    <div class="d-tip" id="d-tip" role="tooltip" hidden></div>
    <script is:inline>
      // Tooltips: any element (or ancestor, up to 6 levels) with data-tip shows it on hover AND keyboard focus.
      // No third-party code, no cookies. Touch: first tap shows the tip, tap elsewhere hides it.
      (function () {
        var tip = document.getElementById('d-tip');
        function find(el) { for (var i = 0; el && i < 6; i++, el = el.parentElement) { if (el.dataset && el.dataset.tip) return el; } return null; }
        function show(el, x, y) {
          tip.textContent = el.dataset.tip; tip.hidden = false;
          var w = tip.offsetWidth, h = tip.offsetHeight;
          if (x + w > innerWidth - 8) x = Math.max(8, x - w - 28);
          if (y + h > innerHeight - 8) y = y - h - 28;
          tip.style.left = x + 'px'; tip.style.top = y + 'px';
        }
        document.addEventListener('mouseover', function (e) { var el = find(e.target); if (el) show(el, e.clientX + 14, e.clientY + 18); else tip.hidden = true; });
        document.addEventListener('mousemove', function (e) { if (!tip.hidden) { var el = find(e.target); if (el) show(el, e.clientX + 14, e.clientY + 18); } });
        document.addEventListener('mouseout', function (e) { if (!e.relatedTarget) tip.hidden = true; });
        document.addEventListener('focusin', function (e) { var el = find(e.target); if (el) { var r = el.getBoundingClientRect(); show(el, r.left, r.bottom + 6); } });
        document.addEventListener('focusout', function () { tip.hidden = true; });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') tip.hidden = true; });
      })();
    </script>
  </body>
</html>
