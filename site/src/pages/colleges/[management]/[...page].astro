---
import { listRange } from '../../../lib/format';
import Layout from '../../../layouts/Layout.astro';
import GroupListing from '../../../components/GroupListing.astro';
import { getSites } from '../../../lib/data';
import { collegesBySection, collegeText, type CollegeSection } from '../../../lib/colleges';

export async function getStaticPaths({ paginate }: { paginate: import('astro').PaginateFunction }) {
  // ADR-025. Both sections are always generated, even when empty, so the links between them never 404.
  const bySection = collegesBySection(getSites());
  return (['government', 'aided'] as const).flatMap((management) =>
    paginate(bySection[management], { params: { management }, pageSize: 100 }),
  );
}

const { management } = Astro.params as { management: 'government' | 'aided' };
const { page } = Astro.props as { page: import('astro').Page<ReturnType<typeof getSites>[number]> };
const bySection = collegesBySection(getSites());
const here = collegeText(management, 'en');
const otherKey: CollegeSection = management === 'government' ? 'aided' : 'government';
const other = collegeText(otherKey, 'en');
---

<Layout title={here.label + 's'} description={here.meaning}>
  <GroupListing
    title={here.label + 's'}
    backHref="/colleges/"
    backLabel="All colleges"
    intro={here.meaning}
    sections={[{ id: 'all', title: listRange(page, 'colleges'), sites: page.data }]}
    groupSites={bySection[management]}
    page={page}
    showDistrict
  >
    <p slot="intro" style="margin:0">See also: <a href={other.href}>{other.label}s</a> ({bySection[otherKey].length}).</p>
  </GroupListing>
</Layout>
