---
import Layout from '../../layouts/Layout.astro';
import GroupListing from '../../components/GroupListing.astro';
import { getSites, getDistricts, getDistrict } from '../../lib/data';
import type { SiteView } from '../../lib/data';
import { comparisonSnapshot } from '../../lib/weekly';

export function getStaticPaths() {
  return getDistricts().map((district) => ({ params: { district: district.id } }));
}

const { district: districtId } = Astro.params;
const district = getDistrict(districtId as string)!;
const sites = getSites()
  .filter((s) => s.district === district.id)
  .sort((a, b) => a.name.localeCompare(b.name));

// Grouped per DESIGN §7.2's `/districts/<slug>/` row, not one flat table -- each group here stays
// well under ADR-025's 100-row pagination threshold even in the biggest district (grama panchayat
// counts top out around 94), so no listing on this page needs to paginate.
const administration = sites.filter((s) => s.kind === 'district_admin');
const panchayatTiers = sites.filter((s) => s.kind === 'district_panchayat' || s.kind === 'block_panchayat');
const urbanBodies = sites.filter((s) => s.kind === 'corporation' || s.kind === 'municipality');
const gramaPanchayats = sites.filter((s) => s.kind === 'grama_panchayat');
const grouped = new Set([...administration, ...panchayatTiers, ...urbanBodies, ...gramaPanchayats].map((s) => s.id));
const other: SiteView[] = sites.filter((s) => !grouped.has(s.id));

const sections = [
  { id: 'admin', title: 'District administration', sites: administration },
  { id: 'panchayat', title: 'District & block panchayats', sites: panchayatTiers },
  { id: 'urban', title: 'Corporations & municipalities', sites: urbanBodies },
  { id: 'gp', title: 'Grama panchayats', sites: gramaPanchayats, collapsed: true },
  { id: 'other', title: 'Institutions & state bodies headquartered here', sites: other },
].filter((s) => s.sites.length > 0);

const snap = comparisonSnapshot()?.districts[district.id];
---

<Layout title={district.name} description={`Government websites in ${district.name} district.`} active="districts">
  <GroupListing
    title={district.name}
    titleMl={district.name_ml}
    backHref="/districts/"
    backLabel="All districts"
    sections={sections}
    prev={snap ? { broken: snap.broken, median: snap.median, sites: snap.sites } : null}
    showDepartment={false}
  />
</Layout>
