---
// /districts/ — map beside a full ranking.
import Layout from '../../layouts/Layout.astro';
import KeralaMap from '../../components/KeralaMap.astro';
import RankTable from '../../components/RankTable.astro';
import { getDistricts, getSites } from '../../lib/data';
import { medianScore, percentBroken } from '../../lib/rollups';
import { comparisonSnapshot, delta, BROKEN } from '../../lib/weekly';
import { tips } from '../../lib/tips';

const { TIP } = tips('en');

const prev = comparisonSnapshot();
const sites = getSites();
const rows = getDistricts()
  .map((d) => {
    const inDistrict = sites.filter((s) => s.district === d.id);
    const nowBroken = inDistrict.filter((s) => BROKEN.includes(s.status)).length;
    return { name: d.name, href: `/districts/${d.id}/`, sites: inDistrict.length, brokenPct: percentBroken(inDistrict), median: medianScore(inDistrict), delta: delta(nowBroken, prev?.districts[d.id]?.broken, true) };
  })
  .sort((a, b) => b.brokenPct - a.brokenPct);
---

<Layout title="Districts" description="Kerala government websites broken down by district." active="districts">
  <div class="d-stack">
    <div class="d-row" style="align-items:baseline"><h1 class="d-h1">Districts</h1><span class="d-muted">Where are the problems?</span></div>
    <div class="d-split--even">
      <section class="d-card" aria-labelledby="mp" data-tip={TIP.districtMap} tabindex="0">
        <h2 id="mp">Map of Kerala</h2>
        <KeralaMap />
      </section>
      <section class="d-card" aria-labelledby="rk" data-tip={TIP.districtRanking} tabindex="0">
        <h2 id="rk">District ranking</h2>
        <RankTable rows={rows} />
      </section>
    </div>
  </div>
</Layout>
