---
import Layout from '../layouts/Layout.astro';
import HealthBadge from '../components/HealthBadge.astro';
import StatTile from '../components/StatTile.astro';
import CoverageBar from '../components/CoverageBar.astro';
import KeralaMap from '../components/KeralaMap.astro';
import { getDistricts, getSite, getSummary } from '../lib/data';

const summary = getSummary();
const { totals } = summary;
const brokenHeadline = totals.down + totals.hijacked + totals.broken;
const districts = getDistricts();

const recentBroken = summary.recent_broken
  .map((t) => ({ ...t, site: getSite(t.id) }))
  .filter((t) => t.site);
const recentFixed = summary.recent_fixed
  .map((t) => ({ ...t, site: getSite(t.id) }))
  .filter((t) => t.site);
---

<Layout
  title="Home"
  description="Tracking which Government of Kerala websites are up, down or broken, and why."
>
  <h1>Kerala Web Watch</h1>
  <p class="headline">
    <strong>{brokenHeadline}</strong> of <strong>{totals.sites}</strong> Kerala government websites are broken right now.
  </p>
  <p>
    This is Phase 2: every site gets a light check (is it up? valid HTTPS? redirecting somewhere odd?)
    every 6 hours. Deep audits (accessibility, security headers, content quality) start in Phase 3 —
    until then, every site not already flagged shows as <HealthBadge status="unaudited" />.
  </p>

  <section aria-labelledby="map-heading">
    <h2 id="map-heading">By district</h2>
    <KeralaMap />
    <p><a href="/districts/">All districts &rarr;</a></p>
  </section>

  <section aria-labelledby="stats-heading">
    <h2 id="stats-heading">Right now</h2>
    <div class="stat-grid">
      <StatTile label="Down" value={totals.down} tone="bad" href="/status/down/" />
      <StatTile label="Hijacked" value={totals.hijacked} tone="bad" href="/status/hijacked/" />
      <StatTile label="Broken" value={totals.broken} tone="bad" href="/status/broken/" />
      <StatTile label="Unverifiable (geo-blocked)" value={totals.unverifiable} tone="warn" href="/status/unverifiable/" />
      <StatTile label="Not yet audited" value={totals.unaudited} tone="neutral" href="/status/unaudited/" />
    </div>
  </section>

  <section aria-labelledby="coverage-heading">
    <h2 id="coverage-heading">Audit coverage</h2>
    <CoverageBar
      done={summary.coverage.deep_audited}
      total={summary.coverage.total}
      label={`${summary.coverage.deep_audited} of ${summary.coverage.total} sites deep-audited${summary.coverage.eta ? ` — full coverage by ${summary.coverage.eta}` : ''}`}
    />
  </section>

  {(recentBroken.length > 0 || recentFixed.length > 0) && (
    <section aria-labelledby="recent-heading">
      <h2 id="recent-heading">This week</h2>
      {recentBroken.length > 0 && (
        <>
          <h3>Broke this week</h3>
          <ul>
            {recentBroken.map((t) => (
              <li><a href={`/sites/${t.id}/`}>{t.site!.name}</a> — since {t.since}</li>
            ))}
          </ul>
        </>
      )}
      {recentFixed.length > 0 && (
        <>
          <h3>Fixed this week</h3>
          <ul>
            {recentFixed.map((t) => (
              <li><a href={`/sites/${t.id}/`}>{t.site!.name}</a> — since {t.since}</li>
            ))}
          </ul>
        </>
      )}
    </section>
  )}

  <section aria-labelledby="browse-heading">
    <h2 id="browse-heading">Browse</h2>
    <ul>
      <li><a href="/districts/">By district</a> ({districts.length} districts)</li>
      <li><a href="/status/down/">Down sites</a></li>
      <li><a href="/status/broken/">Broken sites</a></li>
      <li><a href="/status/unaudited/">Not yet audited</a></li>
    </ul>
    <p class="muted">Ministry, department and kind browsing arrive in a later phase.</p>
  </section>
</Layout>

<style>
  .headline {
    font-size: 1.25rem;
  }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
  }
  .muted {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
