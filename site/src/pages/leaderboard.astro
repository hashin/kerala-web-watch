---
import Layout from '../layouts/Layout.astro';
import RankTable from '../components/RankTable.astro';
import { getSites, getDepartments, getDistricts } from '../lib/data';
import { medianScore, percentBroken, scoreDelta } from '../lib/rollups';
import { comparisonSnapshot, delta, BROKEN } from '../lib/weekly';
import { tips } from '../lib/tips';
import type { RankRowData } from '../lib/types';

const { TIP } = tips('en');

const sites = getSites();
const prev = comparisonSnapshot();
type Group = { id: string; name: string };
const isBroken = (s: (typeof sites)[number]) => BROKEN.includes(s.status);

function rank(groups: Group[], of: (id: string) => typeof sites, base: string, snap: 'departments' | 'districts'): RankRowData[] {
  return groups
    .map((g) => {
      const members = of(g.id);
      return { name: g.name, href: `${base}${g.id}/`, sites: members.length, brokenPct: percentBroken(members), median: medianScore(members), delta: delta(members.filter(isBroken).length, prev?.[snap][g.id]?.broken, true) };
    })
    .filter((r) => r.sites > 0)
    // DESIGN §7.2: % broken ascending (best first), then median descending as the tiebreak.
    .sort((a, b) => a.brokenPct - b.brokenPct || (b.median ?? -1) - (a.median ?? -1))
    .map((r, i) => ({ ...r, rank: i + 1 }));
}
const departments = rank(getDepartments(), (id) => sites.filter((s) => s.department === id), '/departments/', 'departments');
const districts = rank(getDistricts(), (id) => sites.filter((s) => s.district === id), '/districts/', 'districts');

const improved = (groups: Group[], of: (id: string) => typeof sites, base: string) =>
  groups
    .map((g) => ({ name: g.name, href: `${base}${g.id}/`, d: scoreDelta(of(g.id)) }))
    .filter((r): r is { name: string; href: string; d: number } => r.d != null && r.d > 0);
const mostImproved = [
  ...improved(getDepartments(), (id) => sites.filter((s) => s.department === id), '/departments/'),
  ...improved(getDistricts(), (id) => sites.filter((s) => s.district === id), '/districts/'),
].sort((a, b) => b.d - a.d).slice(0, 5);

const best = departments.slice(0, 3);
const worst = departments.slice(-3).reverse();
---

<Layout title="Leaderboard" description="Departments and districts ranked by how many of their websites are broken." active="leaderboard">
  <div class="d-stack">
    <div class="d-row" style="align-items:baseline"><h1 class="d-h1">Leaderboard</h1><span class="d-muted" data-tip={TIP.leaderboard} tabindex="0">Ranked by share of sites broken (lower is better), then median score</span></div>
    <p class="d-small d-muted" style="margin:0;max-width:48rem">A group with only a few sites can swing from 0% to 100% broken on one site, so read the Sites column beside every rank.</p>
    <div class="d-chips" role="group" aria-label="Rank by">
      <button class="d-chip" type="button" aria-pressed="true" data-tab="departments" data-tip="Rank the Secretariat departments.">Departments</button>
      <button class="d-chip" type="button" aria-pressed="false" data-tab="districts" data-tip="Rank the 14 districts.">Districts</button>
    </div>
    <div class="d-grid d-grid--2">
      <section class="d-card" aria-labelledby="best-h" data-tip="Departments with the lowest share of broken sites right now." tabindex="0">
        <h2 id="best-h" style="color:var(--teal-ink)">Best 3 departments</h2>
        {best.map((r) => <div class="d-row" style="flex-wrap:nowrap"><strong style="width:1.5rem">{r.rank}</strong><a href={r.href} style="flex:1">{r.name}</a><span style="color:var(--teal-ink)">{r.brokenPct}% broken</span></div>)}
      </section>
      <section class="d-card" aria-labelledby="worst-h" data-tip="Departments with the highest share of broken sites right now." tabindex="0">
        <h2 id="worst-h" style="color:var(--crimson-ink)">Needs the most help</h2>
        {worst.map((r) => <div class="d-row" style="flex-wrap:nowrap"><strong style="width:1.5rem">{r.rank}</strong><a href={r.href} style="flex:1">{r.name}</a><span style="color:var(--crimson-ink)">{r.brokenPct}% broken</span></div>)}
      </section>
    </div>
    <div class:list={[mostImproved.length > 0 ? 'd-split' : 'd-stack']}>
      <section class="d-card" data-pane="departments" aria-label="Departments"><RankTable rows={departments} nameLabel="Department" showRank /></section>
      <section class="d-card" data-pane="districts" aria-label="Districts" hidden><RankTable rows={districts} nameLabel="District" showRank /></section>
      {mostImproved.length > 0 && (
        <aside class="d-card" style="align-self:start" aria-labelledby="imp-h" data-tip={TIP.improved} tabindex="0">
          <h2 id="imp-h">Most improved</h2>
          <p class="d-small d-muted" style="margin-top:0">Median score change over 30 days</p>
          {mostImproved.map((r) => <div class="d-row" style="flex-wrap:nowrap"><a href={r.href} style="flex:1">{r.name}</a><strong style="color:var(--teal-ink)">+{r.d}</strong></div>)}
        </aside>
      )}
    </div>
  </div>
</Layout>

<script is:inline>
  document.querySelectorAll('[data-tab]').forEach(function (b) {
    b.addEventListener('click', function () {
      document.querySelectorAll('[data-tab]').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      document.querySelectorAll('[data-pane]').forEach(function (p) { p.hidden = p.dataset.pane !== b.dataset.tab; });
    });
  });
</script>
