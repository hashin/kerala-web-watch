---
import Layout from '../../layouts/Layout.astro';
import GroupListing from '../../components/GroupListing.astro';
import StackBar from '../../components/StackBar.astro';
import { getMinisters, getMinister, getMinistrySites, getDepartment } from '../../lib/data';
import { countByStatus, percentBroken } from '../../lib/rollups';
import { comparisonSnapshot } from '../../lib/weekly';

export function getStaticPaths() {
  return getMinisters().map((minister) => ({ params: { ministry: minister.id } }));
}

const { ministry: ministryId } = Astro.params;
const minister = getMinister(ministryId as string)!;
const sites = getMinistrySites(minister);

// Portfolio -> departments -> sites (DESIGN §4/§7.2): each department here links through to its
// own (already-paginated) /departments/<id>/ page rather than repeating a possibly huge table --
// `lsgd`'s department alone covers 1,200+ sites, well past ADR-025's pagination threshold.
const departmentRows = minister.departments
  .map((deptId) => {
    const department = getDepartment(deptId);
    const deptSites = sites.filter((s) => s.department === deptId);
    return department ? { department, count: deptSites.length, counts: countByStatus(deptSites), pct: percentBroken(deptSites) } : null;
  })
  .filter((row): row is NonNullable<typeof row> => row !== null)
  .sort((a, b) => a.department.name.localeCompare(b.department.name));

const snap = comparisonSnapshot()?.ministries[minister.id];
---

<Layout title={minister.name} description={`Government websites under the ${minister.name} portfolio.`} active="ministries">
  <GroupListing
    title={minister.name}
    backHref="/ministries/"
    backLabel="All ministries"
    intro={minister.holder ? `Held by ${minister.holder}. ${departmentRows.length} department${departmentRows.length === 1 ? '' : 's'} with tracked sites.` : undefined}
    sections={[]}
    groupSites={sites}
    prev={snap ? { broken: snap.broken, median: snap.median, sites: snap.sites } : null}
  >
    <section class="d-card d-card--flush" aria-labelledby="depts">
      <div class="d-group"><h2 id="depts">Departments</h2></div>
      {departmentRows.length === 0 ? (
        <p style="padding:0 1.25rem">No departments with tracked sites under this portfolio yet.</p>
      ) : (
        <div class="d-scroll" role="region" aria-label="Departments in this portfolio" tabindex="0">
          <table class="d-table">
            <thead>
              <tr>
                <th scope="col">Department</th>
                <th scope="col" data-tip="Registered sites under this department." tabindex="0">Sites</th>
                <th scope="col" data-tip="Mix of health bands across the department's sites." tabindex="0">Health mix</th>
                <th scope="col" data-tip="Share of the department's sites that are down, hijacked or broken." tabindex="0">% broken</th>
              </tr>
            </thead>
            <tbody>
              {departmentRows.map(({ department, count, counts, pct }) => (
                <tr>
                  <td><a href={`/departments/${department.id}/`}>{department.name}</a></td>
                  <td>{count}</td>
                  <td>{count > 0 ? <StackBar counts={counts} mini /> : '—'}</td>
                  <td>{count > 0 ? `${pct}%` : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </GroupListing>
</Layout>
