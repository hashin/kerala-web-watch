---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n';

const locale = 'ml';
const buildDate = new Date().toISOString().slice(0, 10);
// See src/pages/ml/index.astro's comment: `ml.json` is still English text, so this page stays
// `lang="en"` until WP5.3 provides real Malayalam values.
---

<Layout
  title={t(locale, 'about.title')}
  description={t(locale, 'about.intro')}
  lang="en"
  altLangHref="/about/"
  altLangLabel="English"
>
  <h1>{t(locale, 'about.heading')}</h1>

  <p>{t(locale, 'about.intro')}</p>

  <h2>{t(locale, 'about.contactHeading')}</h2>
  <p>{t(locale, 'about.contactBody')}</p>

  <h2>{t(locale, 'about.contributeHeading')}</h2>
  <p>{t(locale, 'about.contributeBody')}</p>

  <h2>{t(locale, 'about.privacyHeading')}</h2>
  <p>{t(locale, 'about.privacyBody')}</p>

  <h2>{t(locale, 'about.licenceHeading')}</h2>
  <p>{t(locale, 'about.licenceBody')}</p>

  <p>
    <a href="/sitemap-index.xml">Sitemap</a> &middot; Last updated {buildDate}
  </p>
</Layout>
