---
import Layout from '../../layouts/Layout.astro';
import SnapshotHome from '../../components/SnapshotHome.astro';
import { t } from '../../i18n';

const locale = 'ml';
---

<Layout
  title={t(locale, 'home.title')}
  description={t(locale, 'home.intro')}
  lang="ml"
  locale={locale}
  active="snapshot"
  altLangHref="/"
  altLangLabel="English"
>
  <SnapshotHome locale={locale} />

  <p class="d-card partial-notice">
    <strong>{t(locale, 'home.partialNoticeHeading')}:</strong>
    {t(locale, 'home.partialNotice')}
    {' '}<a href="/">{t(locale, 'home.fullSiteLink')}</a>
  </p>
</Layout>

<style>
  .partial-notice {
    max-width: 60ch;
    margin-top: 1rem;
    color: var(--color-muted);
  }
</style>
