---
import Layout from '../../layouts/Layout.astro';
import PagefindSearch from '../../components/PagefindSearch.astro';
import { t } from '../../i18n';

const locale = 'ml';
---

<Layout
  title={t(locale, 'home.title')}
  description={t(locale, 'home.intro')}
  lang="ml"
  locale={locale}
  altLangHref="/"
  altLangLabel="English"
>
  <h1>{t(locale, 'home.heading')}</h1>
  <p>{t(locale, 'home.intro')}</p>

  <section aria-labelledby="search-heading">
    <h2 id="search-heading">{t(locale, 'home.searchHeading')}</h2>
    <PagefindSearch id="ml-home-search" />
  </section>

  <p class="partial-notice">
    <strong>{t(locale, 'home.partialNoticeHeading')}:</strong>
    {t(locale, 'home.partialNotice')}
    {' '}<a href="/">{t(locale, 'home.fullSiteLink')}</a>
  </p>
</Layout>

<style>
  .partial-notice {
    max-width: 60ch;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    color: var(--color-muted);
  }
</style>
