---
// /reports/ shows the latest month with the same component as /reports/<month>/, so there is one
// design to keep right. With no report published yet it explains when the first one arrives.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ReportView from '../../components/ReportView.astro';

const latest = (await getCollection('reports')).sort((a, b) => b.data.month.localeCompare(a.data.month))[0];
---

{latest ? (
  <ReportView entry={latest} />
) : (
  <Layout title="Monthly reports" description="The state of Kerala government websites, one month at a time." active="reports">
    <h1 class="d-h1">Monthly reports</h1>
    <p>On the 1st of every month we publish a snapshot of how many sites are down or broken and how that moved. No report has been published yet — check back after the 1st.</p>
  </Layout>
)}
