---
// Site report card: the page a citizen or a departmental webmaster reads for one site.
import Layout from '../../layouts/Layout.astro';
import { getActionReport, actionView } from '../../lib/actions';
import { t } from '../../i18n';
import ActionList from '../../components/ActionList.astro';
import CollegeManagement from '../../components/CollegeManagement.astro';
import HealthBadge from '../../components/HealthBadge.astro';
import ScoreRing from '../../components/ScoreRing.astro';
import CategoryBars from '../../components/CategoryBars.astro';
import IssueCard from '../../components/IssueCard.astro';
import Sparkline from '../../components/Sparkline.astro';
import AvailabilityStrip from '../../components/AvailabilityStrip.astro';
import Screenshot from '../../components/Screenshot.astro';
import TechFacts from '../../components/TechFacts.astro';
import SiteActions from '../../components/SiteActions.astro';
import RelatedSites from '../../components/RelatedSites.astro';
import { getSites, getDepartment, getDistrict, getMinistryForDepartment, explainStatus, CHECKS } from '../../lib/data';
import type { Issue } from '../../../../audit/dist/score.js';
import { timeAgo } from '../../lib/format';
import { platformWideIssues } from '../../lib/rollups';
import { TIP } from '../../lib/tips';

export function getStaticPaths() {
  return getSites().map((site) => ({ params: { id: site.id }, props: { site } }));
}

const { site } = Astro.props;
const light = site.result?.light ?? null;
const deep = site.result?.deep ?? null;
// ADR-026: a bare "Down"/"Broken"/"Unverifiable" badge tells a citizen nothing they can act on.
const reason = explainStatus(site);

const department = getDepartment(site.department);
const ministry = getMinistryForDepartment(site.department);
const district = site.district ? getDistrict(site.district) : null;

// `deep.error` (WP3.5 step 5) means the run itself never finished -- e.g. the site timed out
// mid-crawl -- as distinct from a run that completed and legitimately found zero issues. Scores
// and issues shown below are always the *last successful* audit's (store.ts's mergeErrorResult
// leaves them untouched), which can be null/empty for a site that has never once finished a deep
// audit; without this distinction "No issues found" would misleadingly read as a clean bill of
// health for a site whose only audit attempt actually failed to run at all.
const auditErrored = deep?.error != null;

const SEVERITY_LABEL: Record<Issue['sev'], string> = { C: 'Critical', H: 'High', M: 'Medium', L: 'Low', I: 'Info' };
const issueGroups = (['C', 'H', 'M', 'L', 'I'] as const)
  .map((sev) => ({ sev, label: SEVERITY_LABEL[sev], issues: (site.result?.issues ?? []).filter((i) => i.sev === sev) }))
  .filter((g) => g.issues.length > 0);

// ADR-008: platform-wide findings are reported once at /platforms/<p>/ -- a member page just
// notes when one of its own issues is part of that shared pattern, instead of repeating the
// platform's own explanation.
const platformSharedIssueIds = site.platform
  ? new Set(platformWideIssues(getSites().filter((s) => s.platform === site.platform)).map((f) => f.id))
  : new Set<string>();
const hasInheritedIssues = site.result?.issues.some((i) => platformSharedIssueIds.has(i.id)) ?? false;

const actionEntry = getActionReport().sites.find((a) => a.id === site.id);
const siteActionViews = (actionEntry?.actions ?? []).map((a) => actionView(a, 'en'));
const compromise = siteActionViews.find((a) => a.grade === 1 && CHECKS[a.check as keyof typeof CHECKS].compromise);

const passedChecks = deep?.checks.filter((c) => c.r === 'pass') ?? [];

// Score change against the nearest reading at least a week old (history is newest-first).
const history = site.result?.history ?? [];
const latestScore = history.find((h) => h.score != null);
const weekAgoScore = history.find((h) => h.score != null && new Date(h.d).getTime() <= Date.now() - 7 * 864e5);
const scoreChange = latestScore?.score != null && weekAgoScore?.score != null ? latestScore.score - weekAgoScore.score : null;

const otherInDepartment = getSites()
  .filter((s) => s.department === site.department && s.id !== site.id)
  .sort((a, b) => a.name.localeCompare(b.name));
const otherInDistrict = site.district
  ? getSites()
      .filter((s) => s.district === site.district && s.id !== site.id)
      .sort((a, b) => a.name.localeCompare(b.name))
  : [];
---

<Layout title={site.name} description={`Status and audit findings for ${site.name}.`} active="snapshot">
  <div class="d-stack">
    <nav aria-label="Breadcrumb" class="d-small d-muted">
      <a class="d-back" href="/">&larr; All sites</a>
      {ministry && <span> · {ministry.name} &rsaquo; </span>}
      {department && <a href={`/departments/${department.id}/`}>{department.name}</a>}
      {district && <span> · <a href={`/districts/${district.id}/`}>{district.name}</a></span>}
    </nav>

    {compromise && (
      <aside class="d-alert" role="alert">
        <strong>{t('en', 'actions.compromiseBanner.heading')}</strong>
        <p>{compromise.citizen}</p>
      </aside>
    )}

    <div class="d-row" style="align-items:flex-start">
      <div style="flex:1;min-width:16rem">
        <h1 class="d-h1">{site.name}{site.name_ml && <span lang="ml" class="d-muted" style="font-size:1.25rem"> · {site.name_ml}</span>}</h1>
        <p class="d-muted" style="margin:.3rem 0 0">
          {site.status === 'hijacked' ? <span class="d-hijacked-url">{site.url}</span> : <a href={site.url}>{site.url}</a>}
          {deep && <> · audited {timeAgo(deep.at)}</>}{light && <> · checked {timeAgo(light.at)}</>}
        </p>
        {reason && <p style="max-width:60ch;margin:.5rem 0 0">{reason.citizen}</p>}
        <CollegeManagement site={site} locale={'en'} />
      </div>
      <HealthBadge status={site.status} />
    </div>

    {auditErrored && (
      <p class="d-callout d-callout--warn">
        The most recent attempt to fully audit this site didn't finish ({timeAgo(deep!.at)}) — the scores and issues below, if any, are from the last audit that did complete.
      </p>
    )}
    {site.notes && <p class="d-callout">{site.notes}</p>}

    <div class="d-report">
      <section class="d-card d-stack" style="align-items:center;gap:.5rem" data-tip={TIP.siteScore} tabindex="0">
        <ScoreRing score={site.result?.score?.overall ?? null} />
        <strong>Overall score</strong>
        {scoreChange != null && (
          <span class={`d-delta d-delta--${scoreChange < 0 ? 'bad' : scoreChange > 0 ? 'good' : 'flat'}`} data-tip={TIP.siteScoreChange} tabindex="0">
            {scoreChange === 0 ? 'no change' : `${scoreChange > 0 ? '▲' : '▼'} ${Math.abs(scoreChange)} vs last week`}
          </span>
        )}
      </section>
      {deep && (
        <section class="d-card" aria-labelledby="scores-heading" data-tip={TIP.sixChecks} tabindex="0">
          <h2 id="scores-heading">Six checks</h2>
          <CategoryBars score={site.result?.score ?? null} />
        </section>
      )}
      <section class:list={['d-card', deep && 'd-wide']} aria-labelledby="screenshot-heading" data-tip={TIP.screenshot} tabindex="0">
        <h2 id="screenshot-heading">Screenshot</h2>
        <Screenshot id={site.id} siteName={site.name} screenshot={deep?.screenshot ?? null} reason={reason} />
      </section>
    </div>

    <ActionList actions={siteActionViews} locale="en" />

    {deep && (
      <section class="d-card" aria-labelledby="issues-heading" data-tip={TIP.openIssues} tabindex="0">
        <h2 id="issues-heading">Open issues · {site.result?.issues.length ?? 0}</h2>
        {hasInheritedIssues && (
          <p class="d-small d-muted">
            Some of these issues are shared by most sites on the {site.platform} platform &mdash;
            see the <a href={`/platforms/${site.platform}/`}>platform page</a> for the platform-wide findings.
          </p>
        )}
        {issueGroups.length === 0 && !auditErrored && <p>No issues found in the most recent audit.</p>}
        {issueGroups.length === 0 && auditErrored && <p>No issues on record from a completed audit yet.</p>}
        {issueGroups.map((group) => (
          <div>
            <h3 class="d-small d-muted" style="margin:1rem 0 .4rem">{group.label}</h3>
            {group.issues.map((issue) => <IssueCard issue={issue} />)}
          </div>
        ))}
        {passedChecks.length > 0 && (
          <details>
            <summary>{passedChecks.length} checks passed</summary>
            <ul class="d-cols">
              {passedChecks.map((c) => <li>{CHECKS[c.id].title.en}</li>)}
            </ul>
          </details>
        )}
      </section>
    )}

    <section class="d-card" aria-labelledby="availability-heading" data-tip={TIP.uptime} tabindex="0">
      <h2 id="availability-heading">Uptime — last 90 days</h2>
      <AvailabilityStrip history={history} />
      {deep && <Sparkline history={history} />}
    </section>

    <div class="d-grid d-grid--2">
      <section class="d-card" aria-labelledby="tech-heading" data-tip={TIP.techFacts} tabindex="0">
        <h2 id="tech-heading">Technical facts</h2>
        <TechFacts light={light} tech={deep?.tech ?? null} platform={site.platform} />
      </section>
      <section class="d-card" aria-labelledby="actions-heading" data-tip={TIP.siteActions} tabindex="0">
        <h2 id="actions-heading">Actions</h2>
        <SiteActions id={site.id} name={site.name} />
        {!light && <p class="d-small d-muted">Not light-checked yet — the next scheduled run is within 6 hours.</p>}
        {light && !deep && site.status === 'unaudited' && (
          <p class="d-small d-muted">Not deep-audited yet. Findings appear once the rolling deep audit reaches it — see the <a href="/methodology/">methodology</a>.</p>
        )}
      </section>
    </div>

    <RelatedSites
      headingId="related-department"
      title={`Other sites under ${department?.name ?? site.department}`}
      sites={otherInDepartment}
      seeAllHref={`/departments/${site.department}/`}
      seeAllLabel={`See all sites in ${department?.name ?? site.department}`}
    />
    {district && (
      <RelatedSites
        headingId="related-district"
        title={`Other sites in ${district.name}`}
        sites={otherInDistrict}
        seeAllHref={`/districts/${district.id}/`}
        seeAllLabel={`See all sites in ${district.name}`}
      />
    )}
  </div>
</Layout>
