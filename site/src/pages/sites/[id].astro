---
import Layout from '../../layouts/Layout.astro';
import HealthBadge from '../../components/HealthBadge.astro';
import AvailabilityStrip from '../../components/AvailabilityStrip.astro';
import { getSites, explainStatus } from '../../lib/data';

export function getStaticPaths() {
  return getSites().map((site) => ({ params: { id: site.id }, props: { site } }));
}

const { site } = Astro.props;
const light = site.result?.light ?? null;
// ADR-026: a bare "Down"/"Broken"/"Unverifiable" badge tells a citizen nothing they can act on.
const reason = explainStatus(site);
---

<Layout title={site.name} description={`Status and audit findings for ${site.name}.`}>
  <p><a href="/">&larr; All sites</a></p>
  <h1>
    {site.name}
    {site.name_ml && <span lang="ml"> &middot; {site.name_ml}</span>}
  </h1>
  <p>
    <a href={site.url}>{site.url}</a>
    &nbsp;<HealthBadge status={site.status} />
  </p>
  {reason && <p class="status-reason">{reason.citizen}</p>}

  <dl>
    <dt>Tier</dt>
    <dd>{site.tier}</dd>
    <dt>Kind</dt>
    <dd>{site.kind}</dd>
    <dt>Department</dt>
    <dd><a href={`/departments/${site.department}/`}>{site.department}</a></dd>
    {site.district && (
      <>
        <dt>District</dt>
        <dd><a href={`/districts/${site.district}/`}>{site.district}</a></dd>
      </>
    )}
  </dl>

  {light ? (
    <section aria-labelledby="light-heading">
      <h2 id="light-heading">Light check</h2>
      <p>Last checked {new Date(light.at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' })}.</p>
      <dl>
        <dt>Final URL</dt>
        <dd>{light.final_url ?? '—'}</dd>
        {light.tls && (
          <>
            <dt>TLS certificate</dt>
            <dd>
              {light.tls.valid ? 'Valid' : 'Invalid'}
              {light.tls.days_left !== null && ` — expires in ${light.tls.days_left} days (${light.tls.expires})`}
              {light.tls.issuer && ` — issued by ${light.tls.issuer}`}
            </dd>
          </>
        )}
        <dt>Security headers</dt>
        <dd>
          HSTS {light.headers.hsts ? '✓' : '✗'} &middot;
          CSP {light.headers.csp ? '✓' : '✗'} &middot;
          X-Frame-Options {light.headers.xfo ? '✓' : '✗'} &middot;
          X-Content-Type-Options {light.headers.xcto ? '✓' : '✗'}
        </dd>
      </dl>
      <h3>Last 90 days</h3>
      <AvailabilityStrip history={site.result?.history ?? []} />
    </section>
  ) : (
    <p>This site has not been light-checked yet — the next scheduled run is within 6 hours.</p>
  )}

  {site.status === 'unaudited' && (
    <p>
      This site has not been deep-audited yet. Findings will appear here once Phase 3's audit
      checks are running (see the <a href="/methodology/">methodology</a> page).
    </p>
  )}

  <p><a href={`https://github.com/hashin/kerala-web-watch/issues/new?title=${encodeURIComponent(`Correction: ${site.name}`)}`}>Suggest a correction</a></p>
</Layout>

<style>
  .status-reason {
    max-width: 60ch;
    color: var(--color-text-muted, inherit);
  }
</style>
