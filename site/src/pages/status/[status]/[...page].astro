---
import { listRange } from '../../../lib/format';
import Layout from '../../../layouts/Layout.astro';
import GroupListing from '../../../components/GroupListing.astro';
import { getSites, STATUSES, STATUS_DESCRIPTIONS } from '../../../lib/data';
import { STATUS_WORD } from '../../../lib/bands';
import type { Status } from '../../../lib/data';

export async function getStaticPaths({ paginate }: { paginate: import('astro').PaginateFunction }) {
  // ADR-025: `unaudited` alone can be well over 1,000 rows before Phase 3's deep audit starts, so
  // every status listing paginates at 100 rows/page the same way department/district ones do.
  // Defined inside this function, not at module scope -- see the identical note in
  // departments/[department]/[...page].astro for why (an Astro build-time tree-shaking quirk).
  const PAGE_SIZE = 100;
  const sites = getSites();
  return STATUSES.flatMap((status) => {
    const rows = sites.filter((s) => s.status === status).sort((a, b) => a.name.localeCompare(b.name));
    return paginate(rows, { params: { status }, pageSize: PAGE_SIZE });
  });
}

const { status } = Astro.params as { status: Status };
const { page } = Astro.props as { page: import('astro').Page<ReturnType<typeof getSites>[number]> };
---

<Layout title={`Status: ${STATUS_WORD[status]}`} description={`Government websites currently marked "${status}".`} active="snapshot">
  <GroupListing
    title="Status"
    badge={status}
    backHref="/"
    backLabel="This week's snapshot"
    intro={STATUS_DESCRIPTIONS[status]}
    sections={[{ id: 'all', title: listRange(page), sites: page.data }]}
    page={page}
    showDistrict
    summary={false}
  />
</Layout>
